    {
      "parameters": {
        "jsCode": "// =======================================\n// 1. Capturar JSON retornado pelo Gemini\n// =======================================\n\nlet raw = $json.content?.parts?.[0]?.text || \"\";\n\n// Remover possíveis marcas de bloco markdown\nraw = raw\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// =======================================\n// 2. Tentar localizar o JSON interno\n// =======================================\n\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\n\nif (!match) {\n  return [{\n    json: {\n      error: \"Nenhum JSON encontrado em parts[0].text\",\n      raw\n    }\n  }];\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(match[0]);\n} catch (e) {\n  return [{\n    json: {\n      error: \"Falha ao fazer parse do JSON\",\n      detalhe: e.message,\n      raw\n    }\n  }];\n}\n\n// =======================================\n// 3. Normalizar campos importantes\n// =======================================\n\nreturn [{\n  json: {\n    tipo_documento: parsed.tipo_documento || \"Outro\",\n    confianca_classificacao: parsed.confianca_classificacao || 0,\n    dados_extraidos: parsed.dados_extraidos || {},\n    texto_completo: parsed.dados_extraidos?.texto_completo || \"\",\n    texto_resumido: parsed.dados_extraidos?.texto_resumido || \"\",\n    parsed_original: parsed\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        0
      ],
      "id": "a7c60290-ea4f-455b-a337-0951d2487bb4",
      "name": "Normalizar Dados do OCR"
    },
    {
      "parameters": {
        "jsCode": "// =======================================\n// 1. Obter a saída bruta do agente\n// =======================================\nlet raw = $json.output || \"\";\n\n// Garantir que é string\nraw = String(raw).trim();\n\n// =======================================\n// 2. Tentar localizar o JSON dentro da resposta\n// =======================================\n\n// Remover espaços, blocos markdown e trechos indesejados\nraw = raw\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Expressão mais tolerante para capturar o JSON\nconst jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n\nif (!jsonMatch) {\n  return [{\n    json: {\n      error: \"Nenhum JSON válido encontrado na resposta do agente.\",\n      raw_output: raw\n    }\n  }];\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(jsonMatch[0]);\n} catch (err) {\n  return [{\n    json: {\n      error: \"Falha ao fazer parse do JSON.\",\n      detalhe: err.message,\n      raw_output: raw\n    }\n  }];\n}\n\n// =======================================\n// 3. Normalizar e garantir todos os campos\n// =======================================\n\nconst safeArray = (value) => Array.isArray(value) ? value : [];\nconst safeString = (value) => typeof value === \"string\" ? value : \"\";\nconst safeNumber = (value) => typeof value === \"number\" ? value : 0;\n\nconst output = {\n  tipo_documento: safeString(parsed.tipo_documento),\n  score: safeNumber(parsed.score),\n  acao: safeString(parsed.acao),\n  prioridade: safeString(parsed.prioridade),\n  motivo: safeString(parsed.motivo),\n  campos_faltantes: safeArray(parsed.campos_faltantes),\n  inconsistencias: safeArray(parsed.inconsistencias),\n  observacoes: safeString(parsed.observacoes),\n\n  // Mantém _raw para debug no n8n, mas não usado no banco\n  _raw: parsed\n};\n\n// =======================================\n// 4. Retornar tudo corretamente\n// =======================================\n\nreturn [{ json: output }];\n"
      },
